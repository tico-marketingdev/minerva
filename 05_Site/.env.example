# ═════════════════════════════════════════════════════════════════
# .ENV.EXAMPLE
# ═════════════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores reais
# ⚠️ NUNCA faça commit do arquivo .env real no GitHub!
# ═════════════════════════════════════════════════════════════════

# ─── Ambiente ──────────────────────────────────────────────────
NODE_ENV=production
# Opções: development, production, staging

# ─── Servidor ──────────────────────────────────────────────────
PORT=3000
# Porta em que o backend vai rodar

# ─── Make.com Webhook (SEGREDO - Backend only!) ───────────────
MAKE_WEBHOOK_URL=https://hook.us2.make.com/h8rfq7xc5kcq8g6lpwt6pvqw2j8hcu1n
# ⚠️ NUNCA exponha isso no frontend!
# Coloque APENAS no backend, dentro de .env

# ─── CORS (URLs permitidas) ────────────────────────────────────
CORS_ORIGINS=https://minerva-digital.com,https://www.minerva-digital.com,http://localhost:3000
# Separe múltiplas URLs com vírgula

# ─── Rate Limiting (Redis) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Se não usar, deixar comentado (vai usar memória)

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
# Opções: error, warn, info, debug

# ─── Email (Opcional - se precisar enviar confirmação) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app
SMTP_FROM=noreply@minerva-digital.com

# ─── Monitoring (Sentry) ──────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Para monitorar erros em produção

# ─── Analytics ────────────────────────────────────────────────
GA_TRACKING_ID=G-XXXXXXXXXX
# Google Analytics (opcional)

# ─── Database (se usar) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/minerva_db
# Para armazenar leads em banco de dados

# ─── Segurança ────────────────────────────────────────────────
JWT_SECRET=sua-chave-secreta-super-segura-aqui
SESSION_SECRET=outra-chave-secreta-aqui
# Gere chaves fortes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ═════════════════════════════════════════════════════════════════
# INSTRUÇÕES DE USO:
# 
# 1. Renomeie este arquivo para .env
# 2. Preencha os valores reais (nunca deixe como exemplo)
# 3. Adicione .env ao .gitignore (IMPORTANTE!)
# 4. Nunca faça commit do .env no Git
# 5. No deploy, configure as variáveis na plataforma de hospedagem
#
# ═════════════════════════════════════════════════════════════════
